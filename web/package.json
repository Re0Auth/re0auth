		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"lucide-svelte": "^1.0.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	}
